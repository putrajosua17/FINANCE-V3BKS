// V3BKS FinanceFlow — Prisma schema
// Dev: SQLite. Production: ganti provider ke "postgresql" + set DATABASE_URL.
// Enum ditulis sebagai String (kompatibel SQLite); nilai valid didokumentasikan di komentar.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & Auth  (multi-user, role: owner | admin | finance)
// ---------------------------------------------------------------------------
model User {
  id           String        @id @default(cuid())
  nama         String
  email        String        @unique
  passwordHash String
  role         String        @default("admin") // owner | admin | finance
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  transactions Transaction[] @relation("CreatedBy")
}

// ---------------------------------------------------------------------------
// Accounts / Rekening  (Cash, BCA, Mandiri, BNI)
// ---------------------------------------------------------------------------
model Account {
  id           String        @id @default(cuid())
  nama         String        @unique
  tipe         String        @default("bank") // cash | bank
  saldoAwal    Float         @default(0)
  isActive     Boolean       @default(true)
  urutan       Int           @default(0)
  // F-01: pemetaan ke akun kas/bank pada Chart of Accounts
  coaId        String?
  coa          ChartOfAccount? @relation(fields: [coaId], references: [id])
  transactions Transaction[]
  bookings     Booking[]
  bills        Bill[]
  bankStatements BankStatement[]
  cashClosings   CashClosing[]
  createdAt    DateTime      @default(now())
}

// ---------------------------------------------------------------------------
// Categories  (income | expense)
// ---------------------------------------------------------------------------
model Category {
  id           String        @id @default(cuid())
  nama         String
  tipe         String // income | expense
  isRecurring  Boolean       @default(false)
  isActive     Boolean       @default(true)
  urutan       Int           @default(0)
  // F-01: pemetaan ke akun pendapatan/beban pada Chart of Accounts
  coaId        String?
  coa          ChartOfAccount? @relation(fields: [coaId], references: [id])
  transactions Transaction[]
  bills        Bill[]
  budgets      Budget[]

  @@unique([nama, tipe])
}

// ---------------------------------------------------------------------------
// RateCard  (master tarif rental & jasa)
// ---------------------------------------------------------------------------
model RateCard {
  id         String   @id @default(cuid())
  kode       String   @unique
  nama       String
  kelompok   String // RENTAL | PHOTOGRAPHER | WASIT | ROMPI | VIDEO | MEMBER
  hari       String? // weekday | weekend | all
  jamMulai   String?
  jamSelesai String?
  durasi     Int? // jam
  harga      Float
  isActive   Boolean  @default(true)
}

// ---------------------------------------------------------------------------
// Transactions  (income & expense)
// ---------------------------------------------------------------------------
model Transaction {
  id         String   @id @default(cuid())
  tanggal    DateTime
  tipe       String // income | expense
  jumlah     Float
  catatan    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])

  // Income-specific
  rateCode    String?
  jam         String?
  durasi      Int?
  tanggalMain DateTime?
  namaEntitas String?
  noHp        String?
  dp          Float?
  pelunasan   Float?
  statusBayar String? // dp | lunas
  pajakDaerah Float?  @default(0) // Pajak Daerah 10%

  // Expense-specific
  tempatBeli String?

  // F-07: dimensi unit bisnis (nullable saat migrasi, di-backfill ke V3BKS-MS)
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])

  // F-01: tautan ke jurnal double-entry yang terbentuk otomatis
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  // F-06: relasi opsional ke kontak (pelanggan/vendor)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  // F-02: baris mutasi bank yang tercocokkan ke transaksi ini (back-relation)
  bankStatementLine BankStatementLine?

  // F-05: soft delete (jangan hapus baris permanen)
  deletedAt   DateTime?
  deletedById String?

  createdById String?
  createdBy   User?    @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([tanggal])
  @@index([tipe])
  @@index([businessUnitId])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Bookings / Jadwal
// ---------------------------------------------------------------------------
model Booking {
  id            String   @id @default(cuid())
  kode          String
  tanggalMain   DateTime
  jamMulai      String?
  jamSelesai    String?
  durasi        Int?
  namaEntitas   String
  noHp          String?
  harga         Float    @default(0)
  dp            Float    @default(0)
  sisaPelunasan Float    @default(0)
  status        String   @default("booked") // booked | dp | lunas | selesai | batal
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id])
  catatan       String?
  createdAt     DateTime @default(now())

  @@index([tanggalMain])
}

// ---------------------------------------------------------------------------
// Bills / Tagihan rutin
// ---------------------------------------------------------------------------
model Bill {
  id             String    @id @default(cuid())
  nama           String
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id])
  nominalEstimasi Float    @default(0)
  siklus         String    @default("bulanan") // bulanan | tahunan | sekali
  jatuhTempo     DateTime
  status         String    @default("pending") // pending | paid
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id])
  catatan        String?
  createdAt      DateTime  @default(now())

  @@index([jatuhTempo])
}

// ---------------------------------------------------------------------------
// Targets  (harian | bulanan)
// ---------------------------------------------------------------------------
model Target {
  id       String   @id @default(cuid())
  periode  String // harian | bulanan
  tanggal  DateTime // untuk harian: tanggal; untuk bulanan: tanggal 1 bulan tsb
  nilai    Float
  businessUnitId String?

  @@unique([periode, tanggal])
}

// ---------------------------------------------------------------------------
// Budget  (anggaran per kategori per periode bulanan, mis. "2026-08")
// ---------------------------------------------------------------------------
model Budget {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  periode    String // format "YYYY-MM"
  nominal    Float    @default(0)
  businessUnitId String?

  @@unique([categoryId, periode])
}

// ---------------------------------------------------------------------------
// Settings  (key-value)
// ---------------------------------------------------------------------------
model Setting {
  key   String @id
  value String
}

// ===========================================================================
// PRD v2.0 — Fase 7 · Fondasi Akuntansi
// ===========================================================================

// ---------------------------------------------------------------------------
// F-07 · Unit Bisnis (cost center) — V3BKS + HSC, 6 unit
// ---------------------------------------------------------------------------
model BusinessUnit {
  id       String  @id @default(cuid())
  kode     String  @unique // V3BKS-MS, V3BKS-CAFE, HSC-BAD, HSC-PADEL, HSC-HYROX, HSC-CAFE
  nama     String
  induk    String // V3BKS | HSC
  tipe     String // lapangan | cafe | kelas
  isActive Boolean @default(true)
  urutan   Int     @default(0)

  transactions   Transaction[]
  journalEntries JournalEntry[]
}

// ---------------------------------------------------------------------------
// F-01 · Chart of Accounts (SAK EMKM)
// ---------------------------------------------------------------------------
model ChartOfAccount {
  id          String  @id @default(cuid())
  kode        String  @unique // 1-1100, 4-1000, dst
  nama        String
  tipe        String // ASET | KEWAJIBAN | EKUITAS | PENDAPATAN | BEBAN | HPP
  subTipe     String? // KAS_BANK | PIUTANG | PERSEDIAAN | ASET_TETAP | UTANG_USAHA | ...
  parentId    String?
  parent      ChartOfAccount?  @relation("Hierarki", fields: [parentId], references: [id])
  children    ChartOfAccount[] @relation("Hierarki")
  saldoNormal String // debit | kredit
  isActive    Boolean          @default(true)

  lines      JournalLine[]
  accounts   Account[]
  categories Category[]

  @@index([tipe])
}

// ---------------------------------------------------------------------------
// F-01 · Jurnal double-entry (append-only)
// ---------------------------------------------------------------------------
model JournalEntry {
  id             String        @id @default(cuid())
  nomor          String        @unique // JV-2026-08-0001
  tanggal        DateTime
  deskripsi      String
  sumber         String // transaction | booking | bill | opname | penyusutan | manual | reversal
  sumberId       String?
  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id])
  isReversal     Boolean       @default(false)
  reversalOfId   String?       @unique
  reversalOf     JournalEntry? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry? @relation("Reversal")
  createdById    String?
  createdAt      DateTime      @default(now())

  lines       JournalLine[]
  transaction Transaction?

  @@index([tanggal])
  @@index([sumber, sumberId])
}

model JournalLine {
  id      String         @id @default(cuid())
  entryId String
  entry   JournalEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  coaId   String
  coa     ChartOfAccount @relation(fields: [coaId], references: [id])
  debit   Float          @default(0)
  kredit  Float          @default(0)
  memo    String?

  @@index([coaId])
  @@index([entryId])
}

// ---------------------------------------------------------------------------
// F-05 · Kunci Periode
// ---------------------------------------------------------------------------
model PeriodLock {
  id             String    @id @default(cuid())
  periode        String // "2026-08"
  businessUnitId String?
  status         String    @default("terbuka") // terbuka | terkunci | final
  dikunciOlehId  String?
  dikunciPada    DateTime?
  catatan        String?

  @@unique([periode, businessUnitId])
}

// ===========================================================================
// PRD v2.0 — Fase 8 · Otomasi Pekerjaan Harian
// ===========================================================================

// ---------------------------------------------------------------------------
// F-02 · Rekonsiliasi Bank
// ---------------------------------------------------------------------------
model BankStatement {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  periodeAwal  DateTime
  periodeAkhir DateTime
  saldoAwal    Float    @default(0)
  saldoAkhir   Float    @default(0)
  namaFile     String?
  status       String   @default("draft") // draft | rekonsiliasi | selesai
  createdById  String?
  createdAt    DateTime @default(now())
  lines        BankStatementLine[]

  @@index([accountId])
}

model BankStatementLine {
  id            String   @id @default(cuid())
  statementId   String
  statement     BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  tanggal       DateTime
  keterangan    String
  debit         Float    @default(0) // uang keluar
  kredit        Float    @default(0) // uang masuk
  saldo         Float?
  refBank       String?
  status        String   @default("belum") // belum | cocok | manual | diabaikan
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  skorCocok     Float?

  @@index([statementId])
  @@index([tanggal])
}

// ---------------------------------------------------------------------------
// F-03 · Tutup Kas Harian
// ---------------------------------------------------------------------------
model CashClosing {
  id              String   @id @default(cuid())
  tanggal         DateTime
  shift           String // pagi | sore | malam | harian
  businessUnitId  String?
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  saldoSistem     Float
  saldoFisik      Float
  selisih         Float
  rincianPecahan  Json?
  catatan         String?
  status          String   @default("draft") // draft | diajukan | disetujui
  dibuatOlehId    String?
  disetujuiOlehId String?
  journalEntryId  String?  @unique
  createdAt       DateTime @default(now())

  @@unique([tanggal, shift, accountId])
  @@index([tanggal])
}

// ---------------------------------------------------------------------------
// F-06 · Kontak (pelanggan/vendor) & Utang Usaha (AP)
// ---------------------------------------------------------------------------
model Contact {
  id          String   @id @default(cuid())
  tipe        String // pelanggan | vendor | keduanya
  nama        String
  noHp        String?
  email       String?
  alamat      String?
  npwp        String?
  termin      Int      @default(0) // hari jatuh tempo
  limitKredit Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchaseInvoices PurchaseInvoice[]
  transactions     Transaction[]

  @@index([tipe])
}

model PurchaseInvoice {
  id             String   @id @default(cuid())
  nomor          String   @unique
  vendorId       String
  vendor         Contact  @relation(fields: [vendorId], references: [id])
  tanggal        DateTime
  jatuhTempo     DateTime
  keterangan     String?
  coaBebanKode   String?  // akun beban/persediaan yang didebit (default 6-9000)
  subtotal       Float
  ppn            Float    @default(0)
  pphDipotong    Float    @default(0) // PPh 23 atas jasa
  total          Float
  terbayar       Float    @default(0)
  status         String   @default("belum") // belum | sebagian | lunas | batal
  businessUnitId String?
  journalEntryId String?  @unique
  createdAt      DateTime @default(now())

  @@index([jatuhTempo])
  @@index([status])
}

// ---------------------------------------------------------------------------
// AuditLog  (jejak aktivitas pengguna)
// ---------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String
  aksi      String // create | update | delete | restore | import | pay | settle | lock | unlock
  entitas   String // transaction | bill | booking | budget | user | periode | ...
  detail    String?
  // F-05: rekonstruksi perubahan nilai lama -> nilai baru
  nilaiLama Json?
  nilaiBaru Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
