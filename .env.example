# ---- Database (PostgreSQL) ----
# Pengembangan lokal: gunakan Postgres via docker-compose (lihat docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/v3bks?schema=public"
# Produksi (Neon/Supabase): contoh
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/v3bks?sslmode=require"

# ---- Auth ----
# Rahasia untuk menandatangani session JWT. Buat: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Owner awal (dipakai skrip seed)
SEED_OWNER_EMAIL="owner@v3bks.id"
SEED_OWNER_PASSWORD="owner123"
