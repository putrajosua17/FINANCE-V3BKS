# ---- Database ----
# Development (local, quick start): SQLite
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL — set provider = "postgresql" in prisma/schema.prisma
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/v3bks?schema=public"

# ---- Auth ----
# Secret for signing session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Default seeded owner account (only used by the seed script)
SEED_OWNER_EMAIL="owner@v3bks.id"
SEED_OWNER_PASSWORD="owner123"
