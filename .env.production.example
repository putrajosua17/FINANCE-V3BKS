# ---- Production environment (PostgreSQL) ----
# Set provider = "postgresql" di prisma/schema.prisma sebelum deploy.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/v3bks?sslmode=require"

# Rahasia JWT untuk session — WAJIB diganti. Buat dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Owner awal (dipakai skrip seed) — ganti password setelah login pertama
SEED_OWNER_EMAIL="owner@v3bks.id"
SEED_OWNER_PASSWORD="ganti-password-ini"
